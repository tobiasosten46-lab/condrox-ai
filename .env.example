# Condrox AI — configuration template
# Copy to .env and fill in values, or export these in your shell.
# Every variable is optional — sensible defaults are built in.

# ── API server ────────────────────────────────────────────────────────────────
# API key for protected endpoints. If unset, a random key is generated per boot
# and printed nowhere — always set this in shared/production environments.
CONDROX_API_KEY=change-me-to-a-long-random-string

# Set to 0 to disable auth for local development (never do this in production)
CONDROX_AUTH_ENABLED=1

# Comma-separated CORS origins (defaults to localhost dev ports)
CONDROX_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limits (slowapi format)
CONDROX_RATE_LIMIT=100/minute
CONDROX_RATE_LIMIT_PROCESS=30/minute
CONDROX_RATE_LIMIT_CREATIVE=10/minute

# ── Storage ───────────────────────────────────────────────────────────────────
# SQLite files are created automatically if missing.
CONDROX_USER_DB=Databases/condrox_users.db
CONDROX_OS_STATE_DB=Databases/condrox_os_state.db
CONDROX_KNOWLEDGE_DB=Databases/condrox_knowledge.db

# ── Knowledge loading ─────────────────────────────────────────────────────────
# Directory of downloaded knowledge chunks (see scripts/download_official_datasets.py)
CONDROX_KNOWLEDGE_ROOT=data/knowledge
# Set to 1 to boot instantly with an empty knowledge backend (recommended first run)
CONDROX_SKIP_KNOWLEDGE_LOAD=1
